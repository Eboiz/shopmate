# Qdrant Cloud credentials (https://cloud.qdrant.io).
QDRANT_URL=
QDRANT_API_KEY=
# shopmate_products on prod, shopmate_products_dev everywhere else.
QDRANT_COLLECTION=shopmate_products_dev

# Bearer token the /search API requires (EMBEDDER_TOKEN on the web app side).
EMBEDDER_TOKEN=

# Supabase project the offline indexer reads the catalog from
# (local values printed by `supabase status`; only the indexer needs the secret key).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
