# Copy to .env.local and fill in. Never commit real values.
# Add a key here only when the code starts using it.

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Session pooler (port 5432) for migrations and seed scripts.
# Contains the DB password: never prefix with NEXT_PUBLIC_, never share in chat.
DATABASE_URL=

# Server-only. Supabase secret key (sb_secret_...): bypasses Row Level Security.
# Used by webhooks, AI tools and sendToConversation (src/lib/supabase/admin.ts).
# Local Supabase prints its own with `pnpm db:start`.
SUPABASE_SECRET_KEY=

# Server-only. Claude API key for the AI engine (src/lib/engine). Never prefix
# with NEXT_PUBLIC_. For the live smoke test and `pnpm engine:eval`, put it in
# .env.test.local instead.
ANTHROPIC_API_KEY=
# Server-only. Optional model override; the engine defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=

# Demo accounts created by `pnpm db:seed` (PB-02): owner and staff of the demo shop.
# PB-19 signs in with the staff one. Pick your own passwords; never commit them.
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=

# Server-only. Langfuse Cloud tracing for the AI engine (optional; off when the
# two keys are empty). Turns are sent as numbers only, never message text.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud is the default; use https://us.cloud.langfuse.com for the US region.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
