# Copy to .env.local and fill in. Never commit real values.
# Add a key here only when the code starts using it.

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Session pooler (port 5432) for migrations and seed scripts.
# Contains the DB password: never prefix with NEXT_PUBLIC_, never share in chat.
DATABASE_URL=

# Server-only. Supabase secret key (sb_secret_...): bypasses Row Level Security.
# Used by webhooks, AI tools and sendToConversation (src/lib/supabase/admin.ts).
# Local Supabase prints its own with `pnpm db:start`.
SUPABASE_SECRET_KEY=

# Server-only. Claude API key for the AI engine (src/lib/engine). Never prefix
# with NEXT_PUBLIC_. For the live smoke test and `pnpm engine:eval`, put it in
# .env.test.local instead.
ANTHROPIC_API_KEY=
# Server-only. Optional gateway URL for the Claude API (no /v1/messages); empty means
# api.anthropic.com. The engine reads it in production too.
ANTHROPIC_API_URL=
# Server-only. Optional model override; the engine defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=
# Server-only, optional. A second key used only when the primary fails with 429 (quota),
# 5xx, 401/403 or a connection error. URL empty means api.anthropic.com.
ANTHROPIC_BACKUP_API_KEY=
ANTHROPIC_BACKUP_API_URL=

# Server-only. PB-10: Jev (OpenRouter Decisions API) routes each AI turn; the
# model then only writes the reply. Empty key: every turn runs the LLM tool loop.
# Customer messages are sent to OpenRouter/TypeSafe when this is set.
OPENROUTER_API_KEY=
# Optional. Defaults to https://openrouter.ai/api/alpha/decisions.
OPENROUTER_API_URL=
# Optional. Pinned Jev version (default typesafe/jev-1.13) so eval runs compare.
JEV_MODEL=

# Demo accounts created by `pnpm db:seed` (PB-02): owner and staff of the demo shop.
# PB-19 signs in with the staff one. Pick your own passwords; never commit them.
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=

# Accounts of the second shop, Mây Boutique: `pnpm db:seed --data=may-boutique`.
# They must differ from the DEMO_* ones (an account belongs to one shop).
MAY_BOUTIQUE_OWNER_EMAIL=
MAY_BOUTIQUE_OWNER_PASSWORD=
MAY_BOUTIQUE_STAFF_EMAIL=
MAY_BOUTIQUE_STAFF_PASSWORD=

# Messenger (PB-15). Server-only. App secret checks X-Hub-Signature-256 on every
# webhook call; the verify token is any random string, entered again in the Meta app
# when setting the Callback URL. Both go to Vercel (Production and Preview).
META_APP_SECRET=
META_VERIFY_TOKEN=
# Used only by `pnpm db:seed` to store the demo shop's Page in channel_accounts.
# Never put these on Vercel: the webhook reads the token from the database.
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=

# Instagram Direct (PB-23). Shares the Messenger webhook, so META_APP_SECRET and
# META_VERIFY_TOKEN above cover it too. Used only by `pnpm db:seed` to store the demo
# shop's Instagram account in channel_accounts; never put these on Vercel. The
# account ID is the Instagram professional account ID (17841…), not the @username:
# Meta app > Messenger > Instagram settings, or
# GET /<page-id>?fields=instagram_business_account with the Page token.
INSTAGRAM_ACCOUNT_ID=
# Optional. The token of the Facebook Page the Instagram account is linked to. Empty
# means MESSENGER_PAGE_ACCESS_TOKEN (the account is linked to the Messenger Page).
INSTAGRAM_PAGE_ACCESS_TOKEN=

# WhatsApp (PB-27). Shares the Messenger webhook, so META_APP_SECRET and
# META_VERIFY_TOKEN above cover it too. Used only by `pnpm db:seed` to store the demo
# shop's phone number in channel_accounts; the webhook reads the token from the
# database, so never put these on Vercel. The phone number ID is the one under
# WhatsApp > API Setup (not the phone number itself). The token shown there expires
# after 24 hours: re-run `pnpm db:seed --only=channels` with a new one, or use a
# system user token with whatsapp_business_messaging.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Telegram (PB-21). Used only by `pnpm db:seed` to store the bot in channel_accounts
# and register its webhook; the webhook reads both from the database, so they never
# go to Vercel. The secret is any random string of A-Z a-z 0-9 _ - (max 256).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Mây Boutique's own chat channels, read by `pnpm db:seed --data=may-boutique`. Every
# channel variable above works here with the MAY_BOUTIQUE_ prefix; a channel that is
# not set is skipped. Seed-only, like the ones above: never put these on Vercel.
# Guide for creating the Page: docs/guide-tao-page-may-boutique.md.
MAY_BOUTIQUE_MESSENGER_PAGE_ID=
MAY_BOUTIQUE_MESSENGER_PAGE_ACCESS_TOKEN=
MAY_BOUTIQUE_INSTAGRAM_ACCOUNT_ID=

# Server-only. Langfuse Cloud tracing for the AI engine (optional; off when the
# two keys are empty). Turns are sent as numbers only, never message text.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud is the default; use https://us.cloud.langfuse.com for the US region.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional. true also sends the conversation messages and the model's reply
# (customer text) to Langfuse. Off by default: each model call then shows only the
# fixed system prompt. Turn it on only where you may store customer messages.
LANGFUSE_CAPTURE_CONTENT=

# PB-30 photo search (server only): the /search API of shopmate-gpu-services on
# Modal, e.g. https://<workspace>--shopmate-gpu-api.modal.run, and the bearer
# token from its Modal secret. Empty EMBEDDER_URL turns photo search off:
# search_products then falls back to text search and never says "exact".
# The shop page's search bar by description or photo (PB-34) uses the same two.
EMBEDDER_URL=
EMBEDDER_TOKEN=
# PB-34: 1 = fake search results for local dev without the search service. Ignored in production.
SEARCH_EMBEDDER_MOCK=
