# Copy to .env.local and fill in. Never commit real values.
# Add a key here only when the code starts using it.

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Session pooler (port 5432) for migrations and seed scripts.
# Contains the DB password: never prefix with NEXT_PUBLIC_, never share in chat.
DATABASE_URL=

# Server-only. Supabase secret key (sb_secret_...): bypasses Row Level Security.
# Used by webhooks, AI tools and sendToConversation (src/lib/supabase/admin.ts).
# Local Supabase prints its own with `pnpm db:start`.
SUPABASE_SECRET_KEY=

# Server-only. Claude API key for the AI engine (src/lib/engine). Never prefix
# with NEXT_PUBLIC_. For the live smoke test and `pnpm engine:eval`, put it in
# .env.test.local instead.
ANTHROPIC_API_KEY=
# Server-only. Optional gateway URL for the Claude API (no /v1/messages); empty means
# api.anthropic.com. The engine reads it in production too.
ANTHROPIC_API_URL=
# Server-only. Optional model override; the engine defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=

# Demo accounts created by `pnpm db:seed` (PB-02): owner and staff of the demo shop.
# PB-19 signs in with the staff one. Pick your own passwords; never commit them.
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=

# Messenger (PB-15). Server-only. App secret checks X-Hub-Signature-256 on every
# webhook call; the verify token is any random string, entered again in the Meta app
# when setting the Callback URL. Both go to Vercel (Production and Preview).
META_APP_SECRET=
META_VERIFY_TOKEN=
# Used only by `pnpm db:seed` to store the demo shop's Page in channel_accounts.
# Never put these on Vercel: the webhook reads the token from the database.
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=

# Telegram (PB-21). Used only by `pnpm db:seed` to store the bot in channel_accounts
# and register its webhook; the webhook reads both from the database, so they never
# go to Vercel. The secret is any random string of A-Z a-z 0-9 _ - (max 256).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Server-only. Langfuse Cloud tracing for the AI engine (optional; off when the
# two keys are empty). Turns are sent as numbers only, never message text.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU cloud is the default; use https://us.cloud.langfuse.com for the US region.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional. true also sends the conversation messages and the model's reply
# (customer text) to Langfuse. Off by default: each model call then shows only the
# fixed system prompt. Turn it on only where you may store customer messages.
LANGFUSE_CAPTURE_CONTENT=
