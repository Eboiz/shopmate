{
  "name": "shopmate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "engine:eval": "vitest run --config vitest.eval.config.ts",
    "eval:injection": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/eval-injection.ts",
    "test:e2e": "playwright test",
    "test:e2e:main": "playwright test e2e/main-flow.spec.ts --workers=1 --repeat-each=3",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "node scripts/db-types.mjs",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed.ts",
    "engine:metrics": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/engine-metrics.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "2.122.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.1.3"
}
